{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cargo",
			"command": "run",
			"args": [
				"--package",
				"gl_winit",
				"--bin",
				"gl_winit"
			],
			"problemMatcher": [
				"$rustc"
			],
			"group": "build",
			"env" :{
				"RUST_LOG": "info"
			},
			"label": "rust: run gl_winit"
		}
	]
}